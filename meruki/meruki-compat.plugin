#!name = 挖煤姬 · 自动签到 & 去广告（兼容版）
#!desc = 无需插件参数，功能同主版本：自动签到 + 屏蔽开屏/首页广告 + 自动抓取 Cookie。控制台：https://app.meruki.cn/__loon__
#!author = zz
#!homepage =
#!icon =
#!date = 2026-11-17
#!openUrl = https://app.meruki.cn/__loon__
#!system = ios

# 如果主版本 meruki.plugin 导入后脚本不执行（老版本 Loon 不支持 [Argument]），用这个版本。
# 本版默认：开屏广告屏蔽=开，首页广告位=开，轮播图=留，签到通知=开。

[Rule]
DOMAIN-SUFFIX,sensorsdata.cn,REJECT
DOMAIN-SUFFIX,oceanengine.com,REJECT

[Script]
http-request ^https?:\/\/([a-z0-9-]+\.)*meruki\.cn\/ script-path=https://raw.githubusercontent.com/Omni-2n/loon-plugins/main/meruki/meruki.js, timeout=60, tag=挖煤姬-Cookie与控制台

http-response ^https?:\/\/([a-z0-9-]+\.)*meruki\.cn\/.*n=.*(GetOpenAd|OpenAd|SplashAd|StartAd|OpenScreen|GetHomeInfoV2) script-path=https://raw.githubusercontent.com/Omni-2n/loon-plugins/main/meruki/meruki.js, requires-body=true, timeout=60, tag=挖煤姬-去广告

cron "30 8 * * *" script-path=https://raw.githubusercontent.com/Omni-2n/loon-plugins/main/meruki/meruki.js, timeout=120, tag=挖煤姬-每日签到

cron "0 21 * * *" script-path=https://raw.githubusercontent.com/Omni-2n/loon-plugins/main/meruki/meruki.js, timeout=120, tag=挖煤姬-签到兜底

[MITM]
hostname = %APPEND% meruki.cn, *.meruki.cn
